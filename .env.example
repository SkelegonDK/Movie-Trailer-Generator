# Server-side provider keys. Copy this file to .env.local and fill in both values.
OPENROUTER_API=
ELEVENLABS_API=

# Optional archive root. Default: .trailer-library in this repo (git-ignored).
TRAILER_LIBRARY_DIR=

# Optional legacy override for the audio folder only. Default: <archive root>/audio.
# Shared by browsers using this server; keep the app local or access-controlled.
TRAILER_AUDIO_LIBRARY_DIR=

# Required when NODE_ENV=production, including deployments with browser-only API keys.
# Use username "studio" and a randomly generated password of at least 20 characters.
# Leave blank only for local development. Never expose an unprotected dev server.
TRAILER_ACCESS_PASSWORD=

# Canonical HTTPS origin for hosted browser requests, without a path.
# Origin validation does not trust Host or forwarding headers.
# Loopback HTTP is supported for local production checks.
TRAILER_PUBLIC_ORIGIN=
