# Server-side provider keys. Copy this file to .env.local and fill in both values.
OPENROUTER_API=
ELEVENLABS_API=

# Optional archive root. Default: .trailer-library in this repo (git-ignored).
TRAILER_LIBRARY_DIR=

# Optional legacy override for the audio folder only. Default: <archive root>/audio.
# Shared by browsers using this server; keep the app local or access-controlled.
TRAILER_AUDIO_LIBRARY_DIR=
